{
  "name": "iptv-playlist-parser",
  "version": "0.15.2-iptvnator.2",
  "description": "A basic IPTV playlist parser",
  "main": "src/index.js",
  "scripts": {
    "test": "jest --coverage",
    "bench": "node scripts/bench.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4gray/iptv-playlist-parser.git"
  },
  "keywords": [
    "iptv",
    "playlist",
    "parser",
    "m3u",
    "m3u8"
  ],
  "author": "Arhey",
  "license": "MIT",
  "jest": {
    "roots": [
      "tests"
    ],
    "testRegex": "tests/(.*?/)?.*test.js$",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "jest": "^28.1.3"
  },
  "bugs": "https://github.com/4gray/iptv-playlist-parser/issues",
  "homepage": "https://github.com/4gray/iptv-playlist-parser#readme",
  "engines": {
    "node": ">=18"
  }
}
